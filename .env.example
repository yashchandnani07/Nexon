# Copy this file to `.env` in the repo root and fill in the values.
#   cp .env.example .env
# `.env` is gitignored. Never commit it and never paste its values into an issue,
# a PR, a commit message or an AI chat.

# ── Shared team database ──────────────────────────────────────────────────────
# One Postgres instance shared by the whole team. Get the value from Yash (privately).
# psycopg2 form, used by every Python service except dlp-gateway:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Same database, SQLAlchemy asyncpg form, used only by dlp-gateway.
# Same USER / PASSWORD / HOST / DBNAME as above; note the different prefix and `ssl=`.
POSTGRES_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?ssl=require

# ── Email monitor (IMAP inbox to watch) ───────────────────────────────────────
# Leave IMAP_ENABLED=false unless you have a dedicated demo mailbox.
IMAP_ENABLED=false
IMAP_USER=
IMAP_PASSWORD=

# ── DLP gateway auth ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ADMIN_PASSWORD=
VIEWER_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
